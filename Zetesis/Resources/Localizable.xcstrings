    "While Zetesis is open, every new book is indexed as soon as it has finished copying.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Zetesis geöffnet ist, wird jedes neue Buch indexiert, sobald es fertig kopiert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο το Zetesis είναι ανοιχτό, κάθε νέο βιβλίο μπαίνει στο ευρετήριο μόλις τελειώσει η αντιγραφή του."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que Zetesis est ouvert, chaque nouveau livre est indexé dès que sa copie est terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché Zetesis è aperto, ogni nuovo libro viene indicizzato appena finisce di essere copiato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки Zetesis відкрито, кожна нова книга індексується, щойно завершиться її копіювання."
          }
        }
      }
    },
